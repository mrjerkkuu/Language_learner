{
  "name": "language-learner-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Backend for the Työelämän ruotsi practice app (Fastify + Prisma).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "postinstall": "prisma generate",
    "pretest": "DATABASE_URL=\"file:./prisma/test.db\" npx prisma migrate reset --force",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/csrf-protection": "^8.0.1",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/secure-session": "^8.3.0",
    "@fastify/static": "^10.1.3",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.4"
  },
  "devDependencies": {
    "prisma": "^7.10.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "mysql2": "^3.24.4",
    "deepmerge-ts": "^8.0.2"
  }
}
