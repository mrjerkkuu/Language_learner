# Example environment file — committed to git as a template ONLY.
# Copy this to `.env.local` for local development and fill in a real key there.
# `.env.local` is git-ignored and must never be committed.
#
# NOTE: On GitHub Pages (static hosting) there is no server, so any value baked
# into the build ends up readable in the browser bundle. Therefore in production
# the API key is NOT read from here — the user enters their own key in the app,
# and it is stored only in the browser's localStorage. See src/services/aiService.js.

# Your AI API key (used only in local `npm run dev`, never committed).
VITE_AI_API_KEY=

# Which provider the key belongs to: gemini | claude | none
VITE_AI_PROVIDER=none
